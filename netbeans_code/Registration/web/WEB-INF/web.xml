        <servlet-name>sigup_2</servlet-name>
        <url-pattern>/sigup_2</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>signup_1</servlet-name>
        <url-pattern>/signup_1</url-pattern>
