    <servlet-mapping>
        <servlet-name>fp2</servlet-name>
        <url-pattern>/fp2</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>fp3</servlet-name>
        <url-pattern>/fp3</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>fp4</servlet-name>
        <url-pattern>/fp4</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Dynamic_fetch</servlet-name>
        <url-pattern>/Dynamic_fetch</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
